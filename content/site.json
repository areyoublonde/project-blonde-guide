 "stuck": [
  {
   "id": "relearn-moves",
   "q": "How do I relearn moves?",
   "tags": "move relearner remember forgot moves summary start relearn",
   "a": "Open a Pokémon’s <b>Summary</b>, go to the <b>Battle Moves</b> page and press <b>START</b>. It is free and works anywhere.",
   "link": [
    "/features/start-relearn/",
    "START Relearn"
   ]
  },
  {
   "id": "mega-evolution",
   "q": "How do I use Mega Evolution?",
   "tags": "mega evolution ring stone start aide elm",
   "a": "Get the <b>Mega Ring</b> from Professor Oak on Radio Tower 5F, collect a stone for free from the aide in Elm’s lab, give it to the matching Pokémon, then in battle open FIGHT and press <b>START</b> before choosing a move.",
   "link": [
    "/items/mega-stones/",
    "Mega Stones"
   ]
  },
  {
   "id": "hm-teach",
   "q": "Do I have to teach HM moves?",
   "tags": "hm cut surf strength rock smash waterfall bag field move teach",
   "a": "No. With the HM in your Bag, press A on the obstacle. Surf and Fly appear in the party menu.",
   "link": [
    "/features/shared-hms/",
    "HMs: shared and bag-based"
   ]
  },
  {
   "id": "exp-share",
   "q": "Where is the Exp. Share?",
   "tags": "exp share experience key item whole party",
   "a": "In your <b>Key Items</b> from the start. Use it to switch it on; it begins off.",
   "link": [
    "/features/exp-share/",
    "Exp. Share"
   ]
  },
  {
   "id": "trade-evo",
   "q": "How do I evolve trade Pokémon without trading?",
   "tags": "trade evolution machoke graveler haunter kadabra linking cord",
   "a": "Every trade evolution has a second method: a level, using the held item directly, or a Linking Cord. The Pokémon’s page lists it.",
   "link": [
    "/features/evolution-methods/",
    "Trade evolutions"
   ]
  },
  {
   "id": "lost-progress",
   "q": "I updated the game and my save is gone",
   "tags": "update save lost progress version new rom",
   "a": "Your save lives in a separate <b>.sav</b> file. Give the new game file the same name as the old one, or import the save in your emulator.",
   "link": [
    "/play/#update",
    "Updating without losing progress"
   ]
  }
 ],
